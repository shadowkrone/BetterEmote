Emote {
  width: 100%;
  height: 24;
  padding: 1;

  .emote-icon {
      left: 4;
      top: 4;
      width: 16;
      height: 16;
  }

  .name {
    left: 23;
    top: 2;
  }

  .description {
    left: 23;
    bottom: 3;
  }

  &:selected {
    padding: 0;
    border: 1 gray;
    background-color: black;
  }
}

.menu-background {
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 160);
}

.menu-container {
  width: 70%;
  height: 85%;
  alignment-x: center;
  alignment-y: center;
  padding: 8;
  space-between-entries: 4;
  background-color: rgba(20, 20, 20, 150);
}

.settings-container {
  width: 100%;
  height: 100%;
  padding: 4;
  space-between-entries: 4;
}

.menu-title {
  alignment-x: center;
}

.menu-search-row {
  width: 100%;
  height: 20;
  space-between-entries: 3;

  .menu-search-input {
    width: 75%;
  }
  .menu-search-button {
    width: 25%;
    height: 20;
  }
}

.menu-add-row {
  width: 100%;
  height: 20;
  space-between-entries: 3;

  .menu-preview {
    width: 16;
    height: 16;
    top: 2;
  }
  .menu-results {
    width: 35%;
  }
  .menu-name-input {
    width: 30%;
  }
  .menu-add-button {
    width: calc(35% - 25);
    height: 20;
  }
}

.menu-status {
  alignment-x: center;
}

.menu-empty {
  alignment-x: center;
  margin-top: 10;
}

.menu-settings-button {
  alignment-x: center;
  width: 100;
  height: 20;
}

.menu-emotes-scroll {
  margin-top: 4;

  .menu-emotes-list {
    left: 0;
    top: 0;
    height: fit-content;
    space-between-entries: 2;

    .menu-emote-row {
      width: 100%;
      height: 24;
      space-between-entries: 3;

      Emote {
        width: calc(100% - 25);
      }
      .menu-remove-button {
        width: 22;
        height: 22;
        top: 1;
      }
    }
  }

  Scrollbar {
    left: 0;
    top: 0;
    width: 5;
    height: 100%;
    margin-left: 3;
  }
}
