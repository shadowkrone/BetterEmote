Emote {
  width: 100%;
  height: 24;
  padding: 1;

  .emote-icon {
      left: 4;
      top: 4;
      width: 16;
      height: 16;
  }

  .name {
    left: 23;
    top: 2;
  }

  .description {
    left: 23;
    bottom: 3;
  }

  &:selected {
    padding: 0;
    border: 1 gray;
    background-color: black;
  }
}

.menu-background {
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 160);
}

.menu-container {
  width: 75%;
  height: 88%;
  alignment-x: center;
  alignment-y: center;
  padding: 10;
  space-between-entries: 5;
  background-color: rgba(18, 18, 24, 235);
}

.menu-header {
  width: 100%;
  height: 16;

  .menu-brand {
    width: fit-content;
    height: 16;
    alignment-x: center;
    top: 0;
    space-between-entries: 4;

    .menu-logo {
      width: 16;
      height: 16;
    }
    .menu-title {
      top: 4;
    }
  }
  .menu-count {
    right: 0;
    top: 4;
  }
}

.menu-search-input {
  width: 100%;
  height: 20;
}

.menu-tabs {
  width: fit-content;
  height: 20;
  space-between-entries: 3;

  .menu-tab {
    width: 80;
    height: 20;
  }
}

.menu-filter-row {
  width: fit-content;
  height: 16;
  space-between-entries: 3;

  .menu-filter-wide {
    width: 70;
    height: 16;
  }
}

.menu-status {
  alignment-x: center;
}

.menu-hint {
  alignment-x: center;
}

.menu-empty {
  alignment-x: center;
  margin-top: 10;
}

.menu-emotes-scroll {
  margin-top: 4;

  .menu-emotes-list {
    left: 0;
    top: 0;
    width: calc(100% - 10);
    height: fit-content;
    space-between-entries: 2;

    .menu-section-label {
      margin-top: 4;
      margin-bottom: 2;
    }

    .menu-card-row {
      width: 100%;
      height: 76;
      space-between-entries: 4;
    }

    .menu-card {
      width: 84;
      height: 76;
      background-color: rgba(255, 255, 255, 12);

      .menu-card-emote {
        left: 26;
        top: 4;
        width: 32;
        height: 32;
      }
      .menu-card-name {
        alignment-x: center;
        top: 40;
      }
      .menu-card-save {
        left: 4;
        bottom: 4;
        width: 76;
        height: 18;
      }
    }

    .menu-more-row {
      width: 100%;
      height: 20;
      margin-top: 4;

      .menu-more-button {
        alignment-x: center;
        width: 100;
        height: 20;
      }
    }

    .menu-emote-row {
      width: 100%;
      height: 24;
      space-between-entries: 3;

      Emote {
        width: calc(100% - 50);
      }
      .menu-rename-button {
        width: 22;
        height: 22;
        top: 1;
      }
      .menu-remove-button {
        width: 22;
        height: 22;
        top: 1;
      }
      .menu-rename-input {
        width: calc(100% - 106);
        top: 2;
      }
      .menu-rename-confirm {
        width: 50;
        height: 22;
        top: 1;
      }
      .menu-rename-cancel {
        width: 50;
        height: 22;
        top: 1;
      }
    }
  }

  Scrollbar {
    left: 0;
    top: 0;
    width: 5;
    height: 100%;
    margin-left: 3;
  }
}

.chat-tab-container {
  right: 2;
  bottom: 16;
  width: 170;
  height: 120;
  padding: 4;
  space-between-entries: 4;
  background-color: rgba(0, 0, 0, 180);
}

.chat-tab-empty {
  width: 100%;
  alignment-x: center;
}

.chat-tab-scroll {
  .chat-tab-list {
    left: 0;
    top: 0;
    width: 100%;
    height: fit-content;

    .chat-tab-grid {
      width: 100%;
      height: fit-content;
      tiles-per-line: 7;
      tile-height: 20;
      space-between-entries: 2;
    }
  }

  Scrollbar {
    left: 0;
    top: 0;
    width: 3;
    height: 100%;
    margin-left: 2;
  }
}

.chat-tab-emote {
  width: 18;
  height: 18;

  &:hover {
    background-color: rgba(255, 255, 255, 40);
  }
}

.chat-tab-menu-button {
  width: 100%;
  height: 16;
}
